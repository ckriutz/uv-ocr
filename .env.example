# -----------------------------------------------------------------------------
# Direct Microsoft Foundry connection
# -----------------------------------------------------------------------------

# Foundry resource endpoint, without /providers/mistral/azure/ocr.
# Find it on the Foundry resource's Overview or deployment Consume page.
# Example: https://my-foundry-resource.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=

# Exact OCR deployment name shown in Foundry under Models + endpoints.
# Example: mistral-ocr-4-0
AZURE_MISTRAL_OCR_DEPLOYMENT=mistral-ocr-4-0

# Optional direct-Foundry key. Leave blank when using Microsoft Entra ID.
# Only the optional API-key example in mistral_ocr_demo.ipynb reads this value.
AZURE_MISTRAL_OCR_API_KEY=

# -----------------------------------------------------------------------------
# Azure AI Gateway / API Management connection
# -----------------------------------------------------------------------------

# Base URL of the custom Mistral OCR API in APIM, including its API suffix.
# Do not use the Foundry-generated project route for this provider-specific OCR
# operation. Do not append /providers/mistral/azure/ocr; the notebooks append it.
# Find the gateway host on the APIM Overview page and the suffix under
# APIM > APIs > Mistral Document OCR > Settings.
# Example: https://my-ai-gateway.azure-api.net/mistral-ocr
AZURE_AI_GATEWAY_ENDPOINT=

# Primary or secondary key from an active APIM subscription whose scope includes
# the custom Mistral Document OCR API. Find it under APIM > Subscriptions.
# Keep the real value only in .env and rotate it if it is ever exposed.
AZURE_AI_GATEWAY_SUBSCRIPTION_KEY=

# Subscription-key header configured by the custom APIM API.
# New custom APIs normally use Ocp-Apim-Subscription-Key. If a 401 response
# includes WWW-Authenticate, use the header name shown in its name="..." value.
AZURE_AI_GATEWAY_KEY_HEADER=Ocp-Apim-Subscription-Key

# How APIM authenticates to Foundry:
# - gateway_managed_identity: recommended; APIM injects the backend bearer token.
# - passthrough_entra: the notebook sends the signed-in developer's bearer token.
AZURE_AI_GATEWAY_AUTH_MODE=gateway_managed_identity
